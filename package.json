{
	"name": "shorelinewebdesign.com",
	"version": "1.0.0",
	"description": "Marketing site for Shoreline Web Design. Static Eleventy build, hand-written LESS, no page builder.",
	"private": true,
	"main": "index.js",
	"scripts": {
		"watch:cms": "npx decap-server",
		"watch:eleventy": "cross-env ELEVENTY_ENV=DEV eleventy --serve",
		"build:eleventy": "cross-env ELEVENTY_ENV=PROD eleventy",
		"start": "run-p watch:*",
		"build": "run-s build:*",
		"preview": "cross-env ELEVENTY_ENV=PROD eleventy --serve",
		"remove-dark-mode": "node scripts/remove-dark-mode.js",
		"remove-decap": "node scripts/remove-decap.js",
		"remove-demo": "node scripts/remove-demo.js",
		"create-page": "node scripts/create-page.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bmoesintelligence/shorelinewebdesign.com.git"
	},
	"keywords": [],
	"author": "Bryan Moore",
	"license": "UNLICENSED",
	"homepage": "https://www.shorelinewebdesign.com",
	"dependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@codestitchofficial/eleventy-plugin-minify": "^1.1.3",
		"@codestitchofficial/eleventy-plugin-sharp-images": "^2.2.0",
		"@quasibit/eleventy-plugin-sitemap": "^2.2.0",
		"autoprefixer": "^10.5.2",
		"codestitch-sharp-image-automation": "^0.5.0",
		"cross-env": "^10.1.0",
		"cssnano": "^7.1.9",
		"decap-server": "^3.9.1",
		"esbuild": "^0.28.1",
		"glob": "^13.0.6",
		"less": "^4.6.7",
		"netlify-plugin-cache": "^1.0.3",
		"npm-run-all2": "^5.0.2",
		"postcss": "^8.5.16"
	}
}